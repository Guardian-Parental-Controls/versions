{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-parental-controls.github.io/versions/schema/feed.schema.json",
  "title": "Guardian release feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "components"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "repository", "artifacts"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Guardian-Parental-Controls/"
        },
        "minimum_supported_version": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "min_server": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "translations_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "install_script": {
          "type": "string",
          "format": "uri"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "checksum_url": {
          "type": "string",
          "format": "uri"
        },
        "signature_checksum": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
